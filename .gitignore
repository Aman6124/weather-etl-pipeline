# Environment variables (never commit secrets)
.env

# Python virtual environment
venv/
.venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated pipeline data
# We ignore raw/processed files so Git stays focused on code, not runtime output.
# Re-run the pipeline locally to regenerate datasets. Keep data/ folders via .gitkeep.
data/raw/*.json
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
